{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "bunVersion": "1.x",
  "installCommand": "bunx bun@1.3.14 install --frozen-lockfile",
  "buildCommand": "bunx bun@1.3.14 run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/team",
      "destination": "/about#founder",
      "permanent": true
    }
  ]
}
