---
type Props = {
  eyebrow: string
  title: string
  id: string
  tone?: 'white' | 'tint'
}

const { eyebrow, title, id, tone = 'white' } = Astro.props
const hasIntro = Astro.slots.has('intro')
---

<section
  id={id}
  class:list={['section-space-inner scroll-mt-8', tone === 'tint' && 'bg-paper-deep']}
  aria-labelledby={`${id}-heading`}
>
  <div class="shell grid gap-7 sm:gap-10 lg:grid-cols-[minmax(0,23fr)_minmax(0,39fr)]">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-heading`} class="section-title mt-3.5 text-wrap sm:mt-5">{title}</h2>
      {hasIntro && (
        <div class="mt-3.5 text-base leading-[1.5625rem] text-ink-soft sm:mt-5 sm:max-w-[26.25rem] sm:text-[1.0625rem] sm:leading-7">
          <slot name="intro" />
        </div>
      )}
    </div>
    <div>
      <slot />
    </div>
  </div>
</section>
