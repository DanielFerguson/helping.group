---
import Logo from './Logo.astro'

const path = Astro.url.pathname
const links = [
  { label: 'Helping Homes', href: '/projects/helping-homes' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Archive', href: '/archive' },
]

const isActive = (href: string) =>
  href === '/projects'
    ? path === '/projects'
    : path === href || path.startsWith(`${href}/`)
---

<header class="relative z-50 border-b border-forest/10 bg-paper/95">
  <div class="shell flex min-h-18 items-center justify-between gap-6">
    <a
      href="/"
      class="inline-flex min-h-12 items-center rounded-sm"
      aria-label="Helping Group home"
    >
      <Logo />
    </a>

    <nav class="hidden items-center gap-5 md:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center border-b-2 px-1 text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'border-forest text-forest'
              : 'border-transparent text-ink-soft hover:text-forest',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a class="button-secondary ml-1" href="mailto:contact@helping.group">
        Contact
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex size-12 items-center justify-center rounded-lg border border-forest/20 bg-white text-forest md:hidden"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span data-menu-open-icon>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </span>
      <span data-menu-close-icon hidden>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </span>
    </button>
  </div>

  <nav
    id="mobile-navigation"
    class="absolute inset-x-0 top-full border-y border-forest/10 bg-paper px-3 py-4 md:hidden"
    aria-label="Mobile"
    data-mobile-menu
    hidden
  >
    <div class="shell flex flex-col">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'flex min-h-12 items-center border-l-2 px-4 font-medium',
            isActive(link.href)
              ? 'border-forest text-forest'
              : 'border-transparent text-ink hover:text-forest',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        class="mt-3 flex min-h-12 items-center justify-center rounded-lg border border-forest/20 px-4 font-semibold text-forest"
        href="mailto:contact@helping.group"
      >
        Contact Helping Group
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
  const openIcon = document.querySelector<HTMLElement>('[data-menu-open-icon]')
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-close-icon]')

  const closeMenu = (returnFocus = false) => {
    if (!toggle || !menu || !openIcon || !closeIcon) return

    menu.hidden = true
    openIcon.hidden = false
    closeIcon.hidden = true
    toggle.setAttribute('aria-expanded', 'false')
    toggle.setAttribute('aria-label', 'Open menu')

    if (returnFocus) toggle.focus()
  }

  toggle?.addEventListener('click', () => {
    if (!menu || !openIcon || !closeIcon) return

    const opening = menu.hidden
    menu.hidden = !opening
    openIcon.hidden = opening
    closeIcon.hidden = !opening
    toggle.setAttribute('aria-expanded', String(opening))
    toggle.setAttribute('aria-label', opening ? 'Close menu' : 'Open menu')

    if (opening) menu.querySelector<HTMLAnchorElement>('a')?.focus()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) closeMenu(true)
  })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && menu && !menu.hidden) closeMenu()
  })
</script>
