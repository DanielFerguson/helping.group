---
import { socialLinks } from '../data/archive'
import Logo from './Logo.astro'
---

<footer class="border-t border-forest/10 bg-paper-deep/60">
  <div class="shell grid gap-12 py-16 md:grid-cols-[1.3fr_0.7fr] md:py-20">
    <div>
      <a
        href="/"
        class="inline-flex min-h-12 items-center"
        aria-label="Helping Group home"
      >
        <Logo />
      </a>
      <p class="mt-6 max-w-xl text-lg leading-8 text-ink-soft">
        Practical digital tools that help people connect during difficult
        moments. Helping Homes remains ready to activate when communities need
        it.
      </p>
      <a
        class="mt-7 inline-flex min-h-11 items-center font-semibold text-forest underline decoration-forest/25 underline-offset-8 hover:decoration-forest"
        href="mailto:contact@helping.group"
      >
        contact@helping.group
      </a>
    </div>

    <div class="grid grid-cols-2 gap-8 text-sm">
      <nav aria-label="Footer">
        <p class="font-semibold text-ink">Explore</p>
        <ul class="mt-4 space-y-3 text-ink-soft">
          <li><a class="hover:text-forest" href="/projects/helping-homes">Helping Homes</a></li>
          <li><a class="hover:text-forest" href="/projects">Projects</a></li>
          <li><a class="hover:text-forest" href="/about">About</a></li>
          <li><a class="hover:text-forest" href="/archive">Archive</a></li>
        </ul>
      </nav>
      <nav aria-label="Social media">
        <p class="font-semibold text-ink">Elsewhere</p>
        <ul class="mt-4 space-y-3 text-ink-soft">
          {socialLinks.map((link) => (
            <li>
              <a
                class="hover:text-forest"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-forest/10">
    <div
      class="shell flex flex-col gap-3 py-6 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} Helping Group. Australia.</p>
      <p>In an emergency, call 000.</p>
    </div>
  </div>
</footer>
