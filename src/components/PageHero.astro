---
type Props = {
  title: string
  /** Stacked layouts only: show the aside between the lead and the actions. */
  asideBeforeActions?: boolean
}

const { title, asideBeforeActions = false } = Astro.props
const hasTop = Astro.slots.has('top')
const hasLead = Astro.slots.has('default')
const hasActions = Astro.slots.has('actions')
const hasAside = Astro.slots.has('aside')
// A hero with only a lead sits tighter under its title than one with actions or an aside.
const lean = !hasActions && !hasAside
---

<section aria-labelledby="page-title">
  <div class:list={['shell pt-10 sm:pt-20', lean ? 'pb-12 sm:pb-24' : 'pb-11 sm:pb-22']}>
    <slot name="top" />
    <h1
      id="page-title"
      class:list={['display-title display-title--page', hasTop && 'mt-5 sm:mt-7']}
    >
      {title}
    </h1>
    {(hasLead || hasActions || hasAside) && (
      <div
        class:list={[
          'mt-5 grid gap-8 lg:gap-20',
          lean ? 'sm:mt-10' : 'sm:mt-14',
          hasAside && 'lg:grid-cols-2',
        ]}
      >
        {(hasLead || hasActions) && (
          <div
            class:list={[
              'flex flex-col gap-7 lg:gap-8',
              asideBeforeActions && hasAside && 'max-lg:contents',
            ]}
          >
            {hasLead && (
              <div class="body-large max-w-[40rem]">
                <slot />
              </div>
            )}
            {hasActions && (
              <div
                class:list={[
                  'flex flex-col gap-8',
                  asideBeforeActions && hasAside && 'max-lg:order-2',
                ]}
              >
                <slot name="actions" />
              </div>
            )}
          </div>
        )}
        {hasAside && (
          <div class:list={['[&>*]:h-full', asideBeforeActions && 'max-lg:order-1']}>
            <slot name="aside" />
          </div>
        )}
      </div>
    )}
  </div>
</section>
