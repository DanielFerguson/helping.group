---
type Props = {
  /** A newline starts a new line of the title; each line then wraps on its own. */
  title: string
  /** Stacked layouts only: show the aside between the lead and the actions. */
  asideBeforeActions?: boolean
  /** Tailwind max-width class for the lead. Defaults to `max-w-[40rem]`. */
  leadWidth?: string
  /** Tailwind margin classes between the title and the lead row. Defaults follow the hero's content. */
  rowSpacing?: string
}

const { title, asideBeforeActions = false, leadWidth = 'max-w-[40rem]', rowSpacing } = Astro.props
const titleLines = title.split('\n')
const hasTop = Astro.slots.has('top')
const hasLead = Astro.slots.has('default')
const hasActions = Astro.slots.has('actions')
const hasAside = Astro.slots.has('aside')
// A hero with only a lead sits tighter under its title than one with actions or an aside.
const lean = !hasActions && !hasAside
---

<section aria-labelledby="page-title">
  <div class:list={['shell pt-10 sm:pt-20', lean ? 'pb-12 sm:pb-24' : 'pb-11 sm:pb-22']}>
    <slot name="top" />
    <h1
      id="page-title"
      class:list={['display-title display-title--page', hasTop && 'mt-5 sm:mt-7']}
    >
      {titleLines.length > 1
        ? titleLines.map((line, index) => (
            <>
              {index > 0 && ' '}
              <span class="block">{line}</span>
            </>
          ))
        : title}
    </h1>
    {(hasLead || hasActions || hasAside) && (
      <div
        class:list={[
          'grid gap-8 lg:gap-20',
          rowSpacing ?? (lean ? 'mt-5 sm:mt-10' : 'mt-5 sm:mt-14'),
          hasAside && 'lg:grid-cols-2',
        ]}
      >
        {(hasLead || hasActions) && (
          <div
            class:list={[
              'flex flex-col gap-7 lg:gap-8',
              asideBeforeActions && hasAside && 'max-lg:contents',
            ]}
          >
            {hasLead && (
              <div class:list={['body-large', leadWidth]}>
                <slot />
              </div>
            )}
            {hasActions && (
              <div
                class:list={[
                  'flex flex-col gap-8',
                  asideBeforeActions && hasAside && 'max-lg:order-2',
                ]}
              >
                <slot name="actions" />
              </div>
            )}
          </div>
        )}
        {hasAside && (
          <div class:list={['[&>*]:h-full', asideBeforeActions && 'max-lg:order-1']}>
            <slot name="aside" />
          </div>
        )}
      </div>
    )}
  </div>
</section>
