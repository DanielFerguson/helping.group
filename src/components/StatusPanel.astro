---
import { helpingHomesStatus } from '../data/helping-homes-status'
import { getStatusPresentation } from '../lib/status'

type Props = {
  compact?: boolean
  showCaseStudyAction?: boolean
}

const { compact = false, showCaseStudyAction = true } = Astro.props
const presentation = getStatusPresentation(helpingHomesStatus)
const formattedDate = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Australia/Melbourne',
}).format(new Date(helpingHomesStatus.lastUpdated))
---

<section
  class:list={[
    'overflow-hidden rounded-xl border',
    presentation.tone === 'activated'
      ? 'border-rust/30 bg-rust/5'
      : 'border-forest/15 bg-white/75',
  ]}
  aria-labelledby="helping-homes-status-heading"
  data-testid="helping-homes-status"
  data-mode={helpingHomesStatus.mode}
  data-availability={helpingHomesStatus.serviceAvailability}
>
  <div
    class:list={[
      'grid gap-8',
      compact
        ? 'p-6 sm:p-8'
        : 'p-6 sm:p-8 lg:grid-cols-[1fr_0.48fr] lg:p-10',
    ]}
  >
    <div>
      <p class="inline-flex items-center gap-2 text-sm font-semibold text-forest">
        <span
          class:list={[
            'size-2.5 rounded-full',
            presentation.tone === 'activated'
              ? 'bg-rust'
              : 'bg-leaf',
          ]}
          aria-hidden="true"
        ></span>
        {presentation.eyebrow}
      </p>
      <h2
        id="helping-homes-status-heading"
        class:list={[
          'mt-4 max-w-2xl font-display font-semibold leading-tight tracking-[-0.03em] text-ink',
          compact ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl',
        ]}
      >
        {presentation.title}
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-ink-soft sm:text-lg">
        {presentation.description}
      </p>
      {presentation.availabilityNote && (
        <p class="mt-5 max-w-2xl rounded-lg border border-forest/12 bg-paper-deep/60 p-4 text-sm leading-6 text-ink-soft">
          <strong class="text-ink">Service availability:</strong>{' '}
          {presentation.availabilityNote}
        </p>
      )}
      <p class="mt-5 text-sm text-ink-soft">
        Status last reviewed <time datetime={helpingHomesStatus.lastUpdated}>{formattedDate}</time>
      </p>
    </div>

    <div class="flex flex-col justify-end gap-3">
      {showCaseStudyAction && (
        <a class="button-primary" href="/projects/helping-homes">
          Explore Helping Homes
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )}
      {presentation.showServiceAction && (
        <a
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-forest/20 px-5 font-semibold text-forest hover:border-forest"
          href={helpingHomesStatus.serviceUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-testid="helping-homes-service-link"
        >
          Open the service
        </a>
      )}
      {!presentation.showServiceAction && (
        <a
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-forest/20 px-5 font-semibold text-forest hover:border-forest"
          href="mailto:contact@helping.group"
        >
          Contact Helping Group
        </a>
      )}
      {helpingHomesStatus.officialGuidance.map((link) => (
        <a
          class="inline-flex min-h-11 items-center justify-center text-center text-sm font-medium text-ink-soft underline decoration-forest/20 underline-offset-4 hover:text-forest"
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
  <div class="border-t border-forest/10 bg-paper-deep/60 px-6 py-4 text-sm text-ink-soft sm:px-8 lg:px-10">
    In immediate danger? Call <strong class="text-ink">000</strong> and follow
    official emergency advice.
  </div>
</section>
