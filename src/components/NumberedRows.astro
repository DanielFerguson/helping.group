---
type Item = { title: string; copy: string }
type Props = {
  items: Item[]
  onTint?: boolean
  /** Smaller titles and copy, for rows with longer titles. */
  compact?: boolean
}

const { items, onTint = false, compact = false } = Astro.props

const row = compact
  ? 'gap-x-3 gap-y-2 py-[1.375rem] md:grid-cols-[3rem_minmax(0,16.875rem)_minmax(0,1fr)] md:gap-x-8 md:py-7 lg:grid-cols-[2.5rem_minmax(0,12rem)_minmax(0,1fr)] lg:gap-x-6 xl:grid-cols-[3rem_minmax(0,16.875rem)_minmax(0,1fr)] xl:gap-x-8'
  : 'gap-x-4 gap-y-2.5 py-6 md:grid-cols-[3rem_minmax(0,16.25rem)_minmax(0,1fr)] md:gap-x-8 md:py-7 lg:grid-cols-[2.5rem_minmax(0,12rem)_minmax(0,1fr)] lg:gap-x-6 xl:grid-cols-[3rem_minmax(0,16.25rem)_minmax(0,1fr)] xl:gap-x-8'
const title = compact
  ? 'text-2xl leading-7 md:text-[1.625rem] md:leading-[1.875rem]'
  : 'text-[1.625rem] leading-[1.15] md:text-[2rem] md:leading-[1.125] lg:text-[1.625rem] lg:leading-[1.15] xl:text-[2rem] xl:leading-[1.125]'
const copy = compact
  ? 'text-[0.9375rem] leading-[1.4375rem] md:text-base md:leading-[1.5625rem]'
  : 'leading-[1.5625rem]'
---

<ol class="ledger">
  {items.map((item, index) => (
    <li
      class:list={[
        'ledger-row grid grid-cols-[1.75rem_minmax(0,1fr)] items-baseline',
        row,
      ]}
      style={onTint ? '--ledger-line: var(--color-line-strong)' : undefined}
    >
      <span class="font-display text-lg leading-7 font-bold text-forest md:text-xl" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <h3 class:list={['font-display font-bold tracking-[-0.03em]', title]}>
        {item.title}
      </h3>
      <p class:list={['col-start-2 text-ink-soft md:col-start-auto', copy]}>{item.copy}</p>
    </li>
  ))}
</ol>
