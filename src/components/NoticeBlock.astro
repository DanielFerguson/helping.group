---
type Props = {
  variant?: 'standard' | 'activated' | 'muted'
  surface?: 'white' | 'tint'
  size?: 'default' | 'page'
  bordered?: boolean
  title: string
  headingId: string
  label?: string
  testid?: string
  level?: 'h2' | 'h3'
}

const {
  variant = 'standard',
  surface = 'white',
  size = 'default',
  bordered = false,
  title,
  headingId,
  label = 'Public notice',
  testid,
  level: Heading = 'h3',
} = Astro.props
const rule = {
  standard: 'border-t-ink',
  activated: 'border-t-rust',
  muted: 'border-t-line',
}[variant]
const labelColour = { standard: 'text-ink', activated: 'text-rust', muted: 'text-ink-soft' }[variant]
const page = size === 'page'
---

<aside
  class:list={[
    'border-t-[6px]',
    rule,
    bordered && 'border border-line',
    page ? 'px-[1.375rem] py-6 sm:p-8' : 'p-7 sm:p-8',
    surface === 'tint' ? 'bg-paper-deep' : 'bg-white',
  ]}
  aria-labelledby={headingId}
  data-testid={testid}
>
  <p
    class:list={[
      'font-bold tracking-[0.08em] uppercase',
      page ? 'text-xs sm:text-[0.8125rem]' : 'text-[0.8125rem]',
      labelColour,
    ]}
  >
    {label}
  </p>
  <Heading
    id={headingId}
    class:list={[
      'font-display font-bold tracking-[-0.03em]',
      page
        ? 'mt-2.5 text-2xl leading-7 sm:mt-4 sm:text-[1.875rem] sm:leading-[2.125rem]'
        : 'mt-4 text-[1.75rem] leading-tight',
      variant === 'muted' ? 'text-ink-soft' : 'text-ink',
    ]}
  >
    {title}
  </Heading>
  <div
    class:list={[
      'space-y-4 text-ink-soft',
      page
        ? 'mt-2.5 text-[0.9375rem] leading-[1.4375rem] sm:mt-3.5 sm:text-base sm:leading-[1.5625rem]'
        : 'mt-3.5 leading-7',
    ]}
  >
    <slot />
  </div>
  <slot name="actions" />
</aside>
