---
import Logo from '../components/Logo.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noIndex
>
  <main id="main-content" class="flex min-h-screen items-center py-16">
    <div class="shell">
      <div class="mx-auto max-w-2xl border-y border-forest/15 py-10 text-center sm:py-14">
        <a href="/" aria-label="Helping Group home" class="inline-flex">
          <Logo />
        </a>
        <p class="mt-10 text-sm font-semibold text-forest">
          Error 404
        </p>
        <h1 class="display-title display-title--page mx-auto mt-5">
          This page isn’t here.
        </h1>
        <p class="body-large mx-auto mt-6 max-w-xl">
          The link may be old, or the page may have moved into the project
          archive.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a class="button-primary" href="/">Return home</a>
          <a class="button-secondary" href="/projects">Browse projects</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
