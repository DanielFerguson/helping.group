---
import PageHero from '../components/PageHero.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SplitSection from '../components/SplitSection.astro'
import { archiveArticles, verifiedPress } from '../data/archive'
import BaseLayout from '../layouts/BaseLayout.astro'

const numberWords = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten']
const count = (total: number, singular: string, plural: string) =>
  `${total} ${total === 1 ? singular : plural}`

const contents = [
  {
    href: '#articles',
    label: 'In our own words',
    count: count(archiveArticles.length, 'article', 'articles'),
  },
  {
    href: '#press',
    label: 'Reported at the time',
    count: count(verifiedPress.length, 'report', 'reports'),
  },
]
const articleCount = numberWords[archiveArticles.length] ?? String(archiveArticles.length)

// Non-breaking spaces make the title break as the design does on a phone.
const heroTitle = 'The\u00a0record, as\u00a0it was\u00a0written.'

const articleColumns =
  'md:grid md:grid-cols-[9.375rem_8.75rem_minmax(0,1fr)] md:gap-x-8 lg:grid-cols-[9rem_7rem_minmax(0,1fr)] lg:gap-x-4 xl:grid-cols-[9.375rem_8.75rem_minmax(0,1fr)] xl:gap-x-8'
const pressColumns =
  'md:grid-cols-[10.5rem_minmax(0,1fr)_minmax(0,1.3fr)_4.5rem] md:gap-x-6 xl:grid-cols-[12.5rem_20rem_minmax(0,1fr)_5rem] xl:gap-x-8'
---

<BaseLayout
  title="Archive"
  description="Original Helping Group articles and verified contemporary coverage documenting the creation of Helping Homes."
>
  <SiteHeader />
  <main id="main-content">
    <PageHero title={heroTitle}>
      <p
        slot="top"
        class="flex items-center gap-2 text-xs font-semibold tracking-[0.08em] text-ink uppercase sm:gap-2.5 sm:text-[0.8125rem]"
      >
        <span class="size-2.5 shrink-0 rounded-full bg-ink-soft ring-2 ring-line" aria-hidden="true"></span>
        Archive · Historical sources
      </p>
      Our early articles and the reporting from the time capture the context in which Helping Homes
      was built. We keep them as historical sources, exactly as they were published, not rewritten
      as current news.

      <nav
        slot="aside"
        aria-labelledby="on-this-page"
        class="border-t-2 border-ink pt-4 lg:border-t-0 lg:border-l-2 lg:pt-0 lg:pl-10"
      >
        <p
          id="on-this-page"
          class="pb-1.5 text-xs leading-4 font-semibold tracking-[0.08em] text-ink-soft uppercase lg:pb-3.5"
        >
          On this page
        </p>
        <ul class="lg:space-y-1">
          {contents.map((item) => (
            <li class="border-t border-line last:border-b">
              <a
                class="group flex min-h-12 items-center justify-between gap-4 font-semibold text-forest lg:min-h-[2.875rem]"
                href={item.href}
              >
                <span class="group-hover:underline group-hover:decoration-forest/30 group-hover:underline-offset-[5px]">
                  {item.label}
                </span>
                <span class="text-sm leading-5 font-normal text-ink-soft">{item.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </PageHero>

    <SplitSection id="articles" tone="tint" eyebrow="Original articles" title="In our own words.">
      <p slot="intro">Our {articleCount} Medium articles, newest first.</p>

      <div class="ledger" style="--ledger-line: var(--color-line-strong)">
        <div
          class:list={[
            'hidden border-b border-line-strong py-3.5 text-xs leading-4 font-semibold tracking-[0.08em] text-ink-soft uppercase',
            articleColumns,
          ]}
          aria-hidden="true"
        >
          <span>Date</span>
          <span>Category</span>
          <span>Article</span>
        </div>
        <ul class="m-0 list-none p-0" data-testid="archive-articles">
          {archiveArticles.map((article) => (
            <li
              class:list={[
                'ledger-row relative flex flex-col gap-2 py-5 md:items-baseline md:py-7',
                articleColumns,
              ]}
            >
              <p class="flex items-center gap-2 text-sm leading-5 md:contents">
                <span class="font-semibold md:text-base md:leading-[1.625rem] lg:text-[0.9375rem] xl:text-base">{article.date}</span>
                <span class="text-ink-soft md:hidden" aria-hidden="true">·</span>
                <span class="text-ink-soft md:text-[0.9375rem] md:leading-[1.625rem]">
                  {article.category}
                </span>
              </p>
              <div class="flex flex-col gap-2">
                <h3>
                  <a
                    class="group/link flex items-start justify-between gap-4 after:absolute after:inset-0 md:items-baseline md:justify-start md:gap-2.5"
                    href={article.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="font-display text-2xl leading-7 font-bold tracking-[-0.02em] group-hover/link:text-forest md:text-[1.625rem] md:leading-[1.875rem] lg:text-[1.375rem] lg:leading-[1.625rem] xl:text-[1.625rem] xl:leading-[1.875rem]">
                      {article.title}
                      <span class="sr-only"> (opens in a new tab)</span>
                    </span>
                    <span class="arrow shrink-0 text-lg leading-7 font-semibold text-forest md:leading-6" aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p class="hidden text-[0.9375rem] leading-6 text-ink-soft md:block">
                  {article.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </SplitSection>

    <section id="press" class="section-space-inner scroll-mt-8" aria-labelledby="press-heading">
      <div class="shell">
        <div class="grid gap-3 sm:gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,31.25rem)] lg:items-end lg:gap-10">
          <div>
            <p class="eyebrow flex">Contemporary reporting</p>
            <h2 id="press-heading" class="section-title mt-3.5 text-wrap sm:mt-5">
              Reported at the time.
            </h2>
          </div>
          <p class="text-base leading-[1.5625rem] text-ink-soft sm:text-[0.9375rem] sm:leading-6">
            We rechecked these links before including them. Coverage is kept as historical
            evidence and doesn’t imply a current partnership.
          </p>
        </div>

        <ul class="ledger mt-6 sm:mt-10" data-testid="archive-press">
          {verifiedPress.map((item) => (
            <li class="ledger-row py-0">
              <a
                class:list={[
                  'group/link grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 py-6 md:py-7',
                  pressColumns,
                ]}
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="col-start-1 row-start-1 flex h-11 items-center md:col-start-1">
                  <img
                    class="logo-mono w-auto max-w-full object-contain object-left"
                    src={item.logo}
                    alt=""
                    width={item.logoWidth}
                    height={item.logoHeight}
                    style={`height:${item.displayHeight}px`}
                    loading="lazy"
                  />
                </span>
                <span class="col-span-2 mt-4 font-display text-xl leading-6 font-bold tracking-[-0.02em] group-hover/link:text-forest md:col-span-1 md:col-start-2 md:row-start-1 md:mt-0 md:text-[1.375rem] md:leading-[1.625rem]">
                  {item.name}
                </span>
                <span class="col-span-2 mt-1 text-[0.9375rem] leading-[1.4375rem] text-ink-soft md:col-span-1 md:col-start-3 md:row-start-1 md:mt-0 md:text-base md:leading-[1.5625rem]">
                  {item.description}
                </span>
                <span class="col-start-2 row-start-1 justify-self-end text-[0.9375rem] leading-[1.375rem] font-semibold whitespace-nowrap text-forest md:col-start-4 md:text-base">
                  Read<span class="sr-only"> (opens in a new tab)</span>
                  <span class="arrow ml-1 inline-block" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
