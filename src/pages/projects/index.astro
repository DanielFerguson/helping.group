---
import { getCollection } from 'astro:content'
import PageHero from '../../components/PageHero.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import StatusLine from '../../components/StatusLine.astro'
import { helpingHomesStatus } from '../../data/helping-homes-status'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatLongDate } from '../../lib/format'
import { getStatusPresentation } from '../../lib/status'

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
)
const currentProject = projects.find(
  (project) => project.data.status === 'standby',
)
const archivedProjects = projects.filter(
  (project) => project.data.status === 'archived',
)

if (!currentProject) {
  throw new Error('A current Helping Group project is required.')
}

const presentation = getStatusPresentation(helpingHomesStatus)
---

<BaseLayout
  title="Projects"
  image="/og/projects.png"
  imageAlt="Helping Group projects: one service we keep ready, three ideas we’ve archived."
  description="Helping Homes is Helping Group’s continuing seasonal project. Explore how it works and the ideas preserved in the project archive."
>
  <SiteHeader />
  <main id="main-content">
    <PageHero title="One service we keep ready. Three ideas we’ve archived.">
      <p slot="top" class="eyebrow flex">Projects</p>
      Our projects started with practical questions. One is a service we still maintain. The
      others are ideas we’ve archived, and we say so plainly.
    </PageHero>

    <section
      id="continuing"
      class="scroll-mt-8 bg-paper-deep py-12 sm:pt-24 sm:pb-26"
      aria-labelledby="continuing-heading"
    >
      <div class="shell">
        <p class="eyebrow flex">Continuing work</p>
        <div
          class="ledger mt-5 border-b border-b-line-strong pt-6 pb-3 sm:mt-7 sm:pt-11 sm:pb-12 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)] lg:gap-x-10 xl:grid-cols-[minmax(0,43.75rem)_minmax(0,1fr)] xl:gap-x-20"
        >
          <div class="lg:row-start-1">
            <h2
              id="continuing-heading"
              class="font-display text-[2.75rem] leading-[2.75rem] font-bold tracking-[-0.04em] sm:text-[4.5rem] sm:leading-[4.5rem]"
            >
              {currentProject.data.title}
            </h2>
            <p class="mt-4 max-w-[38.75rem] leading-[1.5625rem] text-ink-soft sm:mt-6 sm:text-lg sm:leading-[1.8125rem]">
              {currentProject.data.summary}
            </p>
          </div>

          <div
            class="mt-5 flex flex-col gap-2 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:gap-3 lg:border-l-2 lg:border-ink lg:pl-10"
          >
            <StatusLine tone={presentation.tone}>
              Helping Homes · {presentation.eyebrow}
            </StatusLine>
            <p class="text-[0.9375rem] leading-[1.4375rem] text-ink lg:text-[1.0625rem] lg:leading-[1.6875rem]">
              {presentation.summary}
            </p>
            <p class="text-sm leading-5 text-ink-soft">
              {presentation.updatedLabel}{' '}
              <time datetime={helpingHomesStatus.lastUpdated}>
                {formatLongDate(helpingHomesStatus.lastUpdated)}
              </time>
            </p>
          </div>

          <div class="mt-2 lg:col-start-1 lg:row-start-2 lg:mt-5 lg:-mb-3">
            <a class="text-link" href={`/projects/${currentProject.data.slug}`}>
              <span>Explore the service <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="archived"
      class="section-space-inner scroll-mt-8"
      aria-labelledby="archived-heading"
    >
      <div class="shell">
        <div class="grid gap-4 lg:grid-cols-[minmax(0,28.75rem)_minmax(0,1fr)] lg:items-end lg:gap-10">
          <div>
            <p class="eyebrow flex">Archived projects</p>
            <h2 id="archived-heading" class="section-title mt-3.5 text-wrap sm:mt-5">
              Preserved, not live.
            </h2>
          </div>
          <p class="max-w-[32.5rem] leading-[1.5625rem] text-ink-soft sm:text-lg sm:leading-[1.8125rem] lg:pb-1.5">
            None of these is operating now. Each page records the question we asked and where it
            stands.
          </p>
        </div>

        <div class="mt-7 sm:mt-10 lg:mt-14">
          <div
            class="hidden pb-3 text-xs leading-4 font-semibold tracking-[0.08em] text-ink-soft uppercase md:grid md:grid-cols-[minmax(0,1.2fr)_minmax(0,2fr)_minmax(0,1fr)_7.5rem] md:items-end md:gap-x-6 lg:gap-x-8 xl:grid-cols-[20rem_minmax(0,1fr)_12.5rem_8.75rem] xl:gap-x-10"
            aria-hidden="true"
          >
            <span>Project</span>
            <span>What it explored</span>
            <span>Status</span>
            <span class="text-right">Record</span>
          </div>
          <ul class="ledger" data-testid="archived-projects">
            {archivedProjects.map((project) => (
              <li class="ledger-row flex flex-col gap-[1.125rem] py-6 md:grid md:grid-cols-[minmax(0,1.2fr)_minmax(0,2fr)_minmax(0,1fr)_7.5rem] md:items-start md:gap-x-6 md:py-8 lg:gap-x-8 xl:grid-cols-[20rem_minmax(0,1fr)_12.5rem_8.75rem] xl:gap-x-10">
                <h3 class="font-display text-[1.75rem] leading-8 font-bold tracking-[-0.03em]">
                  <a class="hover:text-forest" href={`/projects/${project.data.slug}`}>
                    {project.data.title}
                  </a>
                </h3>
                <div class="flex flex-col gap-1.5 md:pt-[3px]">
                  <p class="text-xs leading-4 font-semibold tracking-[0.08em] text-ink-soft uppercase md:sr-only">
                    What it explored
                  </p>
                  <p class="text-[0.9375rem] leading-[1.4375rem] text-ink md:text-base md:leading-[1.5625rem] md:text-ink-soft">
                    {project.data.summary}
                  </p>
                </div>
                <div class="flex flex-col gap-1.5 md:pt-2">
                  <p class="text-xs leading-4 font-semibold tracking-[0.08em] text-ink-soft uppercase md:sr-only">
                    Status
                  </p>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 md:flex-col md:items-start">
                    <StatusLine tone="archived" as="div">Archived</StatusLine>
                    <p class="text-sm leading-5 text-ink-soft md:pl-[1.125rem]">
                      <span class="md:hidden" aria-hidden="true">· </span>{project.data.period}
                    </p>
                  </div>
                </div>
                <div class="-my-1 md:-mt-1.5 md:mb-0 md:flex md:justify-end">
                  <a class="text-link" href={`/projects/${project.data.slug}`}>
                    <span>
                      Case study <span class="arrow" aria-hidden="true">→</span>
                      <span class="sr-only">: {project.data.title}</span>
                    </span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
