---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    (project) => project.data.status === 'archived',
  )

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }))
}

type Props = {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { Content } = await render(project)
const { data } = project
const projectData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(`/projects/${data.slug}`, Astro.site).toString(),
  image: new URL(data.hero, Astro.site).toString(),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Helping Group',
    url: 'https://helping.group',
  },
}
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.hero}
  structuredData={projectData}
>
  <SiteHeader />
  <main id="main-content">
    <section class="border-b border-forest/10">
      <div class="shell grid gap-12 py-16 lg:grid-cols-[1fr_0.85fr] lg:items-center lg:py-22">
        <div>
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold tracking-[0.04em]">
            <span
              class:list={[
                'border-l-2 pl-2',
                data.status === 'standby'
                  ? 'border-leaf text-forest'
                  : 'border-forest/25 text-ink-soft',
              ]}
            >
              {data.status === 'standby' ? 'On standby' : 'Archived'}
            </span>
            <span class="text-ink-soft">{data.period}</span>
          </div>
          <h1 class="display-title display-title--page mt-5">{data.title}</h1>
          <p class="body-large mt-6 max-w-2xl">{data.summary}</p>
        </div>
        <div class="overflow-hidden rounded-xl border border-forest/10 bg-white p-2">
          <img
            src={data.hero}
            alt={data.heroAlt}
            width="1200"
            height="630"
            class="w-full"
          />
        </div>
      </div>
    </section>

    <section class="section-space bg-paper-deep">
      <div class="shell border-y border-forest/15">
        {[
          ['The challenge', data.challenge],
          ['The response', data.response],
          ['Where it stands', data.outcome],
        ].map(([title, copy], index) => (
          <article class="grid gap-3 border-b border-forest/10 py-6 last:border-b-0 md:grid-cols-[0.12fr_0.45fr_1.2fr] md:gap-8">
            <p class="text-sm font-medium text-forest">0{index + 1}</p>
            <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink">{title}</h2>
            <p class="leading-7 text-ink-soft">{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-space bg-paper-deep/60">
      <div class="shell grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
        <div>
          <p class="eyebrow">Case study</p>
          <h2 class="section-title mt-5">What this project was trying to solve.</h2>
        </div>
        <article class="project-prose max-w-3xl">
          <Content />
        </article>
      </div>
    </section>

    <section class="section-space">
      <div class="shell grid gap-10 border-y border-forest/15 py-8 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="eyebrow">Sources</p>
          <h2 class="mt-5 font-display text-3xl font-semibold tracking-[-0.03em]">
            Follow the record.
          </h2>
        </div>
        <ul class="divide-y divide-forest/10 border-y border-forest/10">
          {data.sources.map((source) => (
            <li>
              <a
                class="group flex min-h-16 items-center justify-between gap-5 py-4 font-semibold text-forest"
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.label}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
