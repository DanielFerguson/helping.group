---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import NoticeBlock from '../../components/NoticeBlock.astro'
import NumberedRows from '../../components/NumberedRows.astro'
import PageHero from '../../components/PageHero.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SourceList from '../../components/SourceList.astro'
import SplitSection from '../../components/SplitSection.astro'
import StatusLine from '../../components/StatusLine.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    (project) => project.data.status === 'archived',
  )

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }))
}

type Props = {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { Content } = await render(project)
const { data } = project
const record = [
  { title: 'The challenge', copy: data.challenge },
  { title: 'The response', copy: data.response },
  { title: 'Where it stands', copy: data.outcome },
]
const sources = data.sources.map((source) => ({
  label: source.label,
  href: source.url,
  external: true,
}))
const projectData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(`/projects/${data.slug}`, Astro.site).toString(),
  image: new URL(data.hero, Astro.site).toString(),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Helping Group',
    url: 'https://helping.group',
  },
}
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.hero}
  structuredData={projectData}
>
  <SiteHeader />
  <main id="main-content">
    <PageHero title={data.title}>
      <Fragment slot="top">
        <nav aria-label="Breadcrumb" class="-mt-3 sm:-mt-8">
          <ol class="flex flex-wrap items-center gap-2.5 text-sm leading-5 text-ink-soft">
            <li>
              <a class="underline underline-offset-4" href="/projects">Projects</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-semibold text-ink" aria-current="page">{data.title}</li>
          </ol>
        </nav>
        <div
          class="mt-8 flex flex-col gap-1 sm:mt-11 sm:flex-row sm:items-center sm:gap-x-6"
          data-testid="archived-status"
        >
          <StatusLine tone="archived">Archived · Not operating</StatusLine>
          <p class="pl-[1.125rem] text-sm leading-5 text-ink-soft sm:pl-0">{data.period}</p>
        </div>
      </Fragment>

      {data.summary}
    </PageHero>

    <section class="bg-paper-deep pt-10 pb-12 sm:pt-18 sm:pb-20">
      <div class="shell">
        <NoticeBlock
          size="page"
          variant="muted"
          split
          level="h2"
          testid="archived-notice"
          headingId="archived-notice-heading"
          title="This project is archived."
        >
          <p>It isn’t active. We keep it here as part of the record.</p>
        </NoticeBlock>
      </div>
    </section>

    <SplitSection id="record" eyebrow="The record" title="What we explored. Where it ended.">
      <NumberedRows onTint items={record} />
    </SplitSection>

    <SplitSection id="case-study" tone="tint" eyebrow="Case study" title="The longer story.">
      <article class="project-prose max-w-[42.5rem]">
        <Content />
      </article>
    </SplitSection>

    <SplitSection id="sources" eyebrow="Sources" title="Follow the record.">
      <SourceList links={sources} label="Sources" />
      <a class="text-link mt-2 sm:mt-7" href="/projects">
        <span><span aria-hidden="true">←</span> All projects</span>
      </a>
    </SplitSection>
  </main>
  <SiteFooter />
</BaseLayout>
