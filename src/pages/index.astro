---
import { getCollection } from 'astro:content'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import StatusPanel from '../components/StatusPanel.astro'
import { archiveArticles, verifiedPress } from '../data/archive'
import BaseLayout from '../layouts/BaseLayout.astro'

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
)
const helpingHomes = projects.find(
  (project) => project.data.slug === 'helping-homes',
)
const archivedProjects = projects.filter(
  (project) => project.data.status === 'archived',
)

if (!helpingHomes) {
  throw new Error('The Helping Homes project entry is required.')
}
---

<BaseLayout
  title="Helping Group"
  description="Helping Group is the Australian not-for-profit behind Helping Homes, a seasonal service connecting people affected by emergencies with practical offers of support."
>
  <SiteHeader />
  <main id="main-content">
    <section class="border-b border-forest/10">
      <div class="shell grid items-center gap-12 py-18 sm:py-22 lg:grid-cols-[1.05fr_0.75fr] lg:gap-20 lg:py-28">
        <div>
          <p class="eyebrow">Helping Group · Australia</p>
          <h1 class="display-title mt-5">
            Practical support in difficult moments.
          </h1>
          <p class="body-large mt-6 max-w-2xl">
            Helping Group is the not-for-profit behind Helping Homes, a
            seasonal service that helps people affected by emergencies find
            accommodation, paddock space and transport offered by the
            community.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a class="button-primary" href="/projects/helping-homes">
              Explore Helping Homes
            </a>
            <a
              class="inline-flex min-h-11 items-center font-medium text-forest underline decoration-forest/25 underline-offset-4 hover:decoration-forest"
              href="/about"
            >
              How Helping Group began
            </a>
          </div>
        </div>

        <figure class="mx-auto w-full max-w-md">
          <div class="overflow-hidden rounded-xl border border-forest/12 bg-white p-2">
            <img
              src="/helping-homes-og.png"
              alt="Helping Homes — safer, together"
              width="1200"
              height="630"
              class="w-full rounded-lg"
            />
          </div>
          <figcaption class="mt-3 flex items-center justify-between gap-4 text-sm text-ink-soft">
            <span>Helping Homes</span>
            <span class="inline-flex items-center gap-2">
              <span class="size-2 rounded-full bg-leaf" aria-hidden="true"></span>
              Currently on standby
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="py-10 sm:py-14">
      <div class="shell">
        <StatusPanel />
      </div>
    </section>

    <section
      id="initiatives"
      class="section-space scroll-mt-8 border-y border-forest/10 bg-white/50"
      aria-labelledby="helping-homes-heading"
    >
      <div class="shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <p class="eyebrow">Helping Homes</p>
          <h2 id="helping-homes-heading" class="section-title mt-5">
            Community offers, brought into one place.
          </h2>
          <p class="body-large mt-6">
            During an emergency, useful support is often already available.
            Helping Homes makes those offers easier to find without replacing
            official warnings or emergency services.
          </p>
          <a
            class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-forest"
            href={`/projects/${helpingHomes.data.slug}`}
          >
            See how Helping Homes works
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="border-y border-forest/15">
          {[
            ['Accommodation', 'A spare room, home or safe place to stay.'],
            ['Paddock space', 'Temporary space for livestock and other animals.'],
            ['Transport', 'Help moving people, animals or essential belongings.'],
          ].map(([title, copy]) => (
            <div class="grid gap-2 border-b border-forest/10 py-6 last:border-b-0 sm:grid-cols-[0.55fr_1fr] sm:gap-8">
              <h3 class="text-lg font-semibold text-ink">{title}</h3>
              <p class="leading-7 text-ink-soft">{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-space" aria-labelledby="archive-projects-heading">
      <div class="shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <div>
          <p class="eyebrow">Project archive</p>
          <h2 id="archive-projects-heading" class="section-title mt-5">
            Earlier ideas, kept as part of the record.
          </h2>
          <p class="mt-5 leading-7 text-ink-soft">
            These projects are no longer active. Their case studies explain
            what each idea set out to do.
          </p>
          <a
            class="mt-6 inline-flex min-h-11 items-center font-medium text-forest underline decoration-forest/25 underline-offset-4"
            href="/projects"
          >
            View all projects
          </a>
        </div>

        <div class="border-t border-forest/15">
          {archivedProjects.map((project) => (
            <a
              class="group grid gap-2 border-b border-forest/15 py-6 sm:grid-cols-[0.45fr_1fr_auto] sm:items-baseline sm:gap-6"
              href={`/projects/${project.data.slug}`}
            >
              <h3 class="text-lg font-semibold text-ink group-hover:text-forest">
                {project.data.title}
              </h3>
              <p class="text-sm leading-6 text-ink-soft">{project.data.summary}</p>
              <span class="text-sm font-medium text-forest">
                Case study <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section
      id="media"
      class="section-space scroll-mt-8 border-y border-forest/10 bg-paper-deep/50"
      aria-labelledby="evidence-heading"
    >
      <div class="shell">
        <div class="max-w-3xl">
          <p class="eyebrow">Evidence and archive</p>
          <h2 id="evidence-heading" class="section-title mt-5">
            A public record of how the work began.
          </h2>
          <p class="body-large mt-6">
            Contemporary coverage and Helping Group’s original articles
            document the service during the 2019–20 bushfire season. They are
            historical sources, not claims of current partnerships.
          </p>
        </div>

        <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-20">
          <div>
            <h3 class="text-sm font-semibold text-ink">Contemporary coverage</h3>
            <div class="mt-4 border-t border-forest/15">
              {verifiedPress.map((item) => (
                <a
                  class="group flex min-h-14 items-center justify-between gap-6 border-b border-forest/15 py-3 text-ink hover:text-forest"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.name}: ${item.description} (opens in a new tab)`}
                >
                  <span>{item.name}</span>
                  <span class="text-sm text-ink-soft" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-ink">From Helping Group</h3>
            <div class="mt-4 border-t border-forest/15">
              {archiveArticles.slice(0, 3).map((article) => (
                <a
                  class="group grid gap-1 border-b border-forest/15 py-4"
                  href={article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="font-medium text-ink group-hover:text-forest">
                    {article.title}
                    <span class="ml-1 text-sm text-ink-soft" aria-hidden="true">↗</span>
                  </span>
                  <span class="text-sm text-ink-soft">{article.date}</span>
                </a>
              ))}
            </div>
            <a
              class="mt-5 inline-flex min-h-11 items-center font-medium text-forest underline decoration-forest/25 underline-offset-4"
              href="/archive"
            >
              Explore the full archive
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space" aria-labelledby="founder-intro-heading">
      <div class="shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <p class="max-w-sm text-xl leading-8 text-ink-soft">
          “Could people with space make it easier for someone evacuating to
          find somewhere safe?”
        </p>
        <div>
          <p class="eyebrow">The origin</p>
          <h2 id="founder-intro-heading" class="section-title mt-5">
            A direct response to a difficult summer.
          </h2>
          <p class="body-large mt-6 max-w-3xl">
            Daniel Ferguson started Helping Homes during the 2019–20 bushfires.
            Helping Group grew around that project, and the practical question
            behind it remains the organisation’s focus.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a class="button-secondary" href="/about#founder">Read our story</a>
            <a
              class="inline-flex min-h-11 items-center font-medium text-forest underline decoration-forest/25 underline-offset-4"
              href="mailto:contact@helping.group"
            >
              contact@helping.group
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
